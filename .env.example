# SchemeSaathi Environment Configuration

# Server Port (AI Studio preview runs on 3000)
PORT=3000

# MongoDB Connection String (leave blank to run in-memory, or provide MongoDB Atlas / local URI)
MONGODB_URI=""

# JWT Secret for session tokens
JWT_SECRET="schemesaathi_super_secret_jwt_key_2026"

# Client URL for CORS
CLIENT_URL="http://localhost:3000"

# GEMINI_API_KEY: Injected by AI Studio if using Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Injected by AI Studio
APP_URL="MY_APP_URL"
